# Environment reference only: Django deliberately does not load .env files.
# Use your shell or Render's Environment settings. Never commit real values.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_PRIVATE_SECRET
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_YOUR_HOSTNAME
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
DATABASE_SSL_REQUIRE=true
PUBLIC_APP_URL=https://REPLACE_WITH_YOUR_HOSTNAME
MAILGUN_API_KEY=REPLACE_WITH_A_NEW_PRIVATE_MAILGUN_API_KEY
MAILGUN_DOMAIN=REPLACE_WITH_YOUR_MAILGUN_SENDING_DOMAIN
MAILGUN_API_BASE_URL=https://api.mailgun.net
MAILGUN_SENDER_EMAIL=REPLACE_WITH_YOUR_SENDER_ADDRESS
MAILGUN_SENDER_NAME=FORM
# Sandbox domains require 1-5 explicitly allowed recipients here AND accepted
# authorized-recipient invitations in Mailgun. No public signup in sandbox.
MAILGUN_SANDBOX_RECIPIENTS=
# Keep API_ORIGINS empty for the recommended same-origin PWA deployment.
API_ORIGINS=
AUTH_THROTTLE_LIMIT=12
TRUST_PROXY_IP=false
